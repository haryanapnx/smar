# Optional MBTA API key. Without it the app still works but MBTA rate-limits requests
# to roughly 20 requests/minute, which can trigger 429 responses during heavy use.
# Get a free key at https://api-v3.mbta.com/register
VITE_MBTA_API_KEY=

# Optional base URL override (e.g. a proxy). Leave empty to use https://api-v3.mbta.com
VITE_MBTA_API_BASE_URL=
